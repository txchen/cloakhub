{
  "name": "cloakhub",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ui": "./scripts/build-ui.sh",
    "build": "./scripts/build-ui.sh && go build -o bin/cloakhub ./cmd/cloakhub",
    "start": "./scripts/build-ui.sh && go run ./cmd/cloakhub",
    "test": "go test ./... && bun test",
    "test:go": "go test ./...",
    "test:js": "bun test",
    "typecheck": "tsc --noEmit && go vet ./...",
    "test:ui": "playwright test",
    "integration:real-runtime": "./scripts/real-runtime-tests.sh",
    "test:browser-evaluation": "node tests/browser-evaluation/run.mjs",
    "test:browser-evaluation:unit": "bun test tests/browser-evaluation.test.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.3.4",
    "esbuild": "0.25.10",
    "playwright-core": "1.64.1",
    "pngjs": "7.0.0",
    "typescript": "^5.9.2"
  }
}
